FROM main | where match(Image, "(?i)\\\\certutil\\.exe$") AND (match(CommandLine, "(?i) \\-decode ") OR match(CommandLine, "(?i) /decode ") OR match(CommandLine, "(?i) –decode ") OR match(CommandLine, "(?i) —decode ") OR match(CommandLine, "(?i) ―decode ")) OR match(CommandLine, "(?i)SUVY") OR match(CommandLine, "(?i)lFW") OR match(CommandLine, "(?i)JRV") OR match(CommandLine, "(?i)aAB0AHQAcA") OR match(CommandLine, "(?i)gAdAB0AHAA") OR match(CommandLine, "(?i)oAHQAdABwA")
